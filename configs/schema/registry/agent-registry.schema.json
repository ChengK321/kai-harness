{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai.local/schema/registry/agent-registry.schema.json",
  "title": "Kai Agent Registry V1.1",
  "type": "object",
  "required": ["version", "default_action", "agents", "defaults", "validation"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "default_action": {"type": "string", "enum": ["deny"]},
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "adapter", "version", "status", "capabilities", "permissions", "memory_access", "tool_access"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "adapter": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["disabled", "enabled", "degraded"]},
          "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "permissions": {"type": "array", "items": {"type": "string", "enum": ["READONLY", "CONTROLLED", "ADMIN"]}},
          "memory_access": {
            "type": "object",
            "required": ["read_layers", "write_layers"],
            "properties": {
              "read_layers": {"type": "array", "items": {"type": "string"}},
              "write_layers": {"type": "array", "items": {"type": "string"}}
            }
          },
          "tool_access": {
            "type": "object",
            "required": ["allow", "deny"],
            "properties": {
              "allow": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "deny": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "execution_scope": {
            "type": "object",
            "required": ["environments"],
            "properties": {
              "environments": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "entry_schema": {"type": "object"},
    "defaults": {"type": "object"},
    "validation": {"type": "object"},
    "extensions": {"type": "object"}
  }
}
