{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai.local/schema/registry/tool-registry.schema.json",
  "title": "Kai Tool Registry V1.1",
  "type": "object",
  "required": ["version", "default_action", "tools", "defaults", "risk_policy", "validation"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "default_action": {"type": "string", "enum": ["deny"]},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "category", "description", "permission_level", "timeout", "requires_approval", "enabled"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "category": {"type": "string", "enum": ["system", "docker", "filesystem", "network", "mcp", "robotics"]},
          "description": {"type": "string"},
          "permission_level": {"type": "string", "enum": ["READONLY", "CONTROLLED", "ADMIN"]},
          "timeout": {"type": "integer", "minimum": 1},
          "requires_approval": {"type": "boolean"},
          "enabled": {"type": "boolean"},
          "side_effect": {"type": "string", "enum": ["none", "reversible", "irreversible"]}
        }
      }
    },
    "entry_schema": {"type": "object"},
    "defaults": {"type": "object"},
    "risk_policy": {"type": "object"},
    "validation": {"type": "object"},
    "extensions": {"type": "object"}
  }
}
