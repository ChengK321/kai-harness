{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai.local/schema/registry/environment-registry.schema.json",
  "title": "Kai Environment Registry V1.1",
  "type": "object",
  "required": ["version", "default_action", "environments", "validation"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "default_action": {"type": "string", "enum": ["deny"]},
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "version", "status", "capabilities", "connection", "safety_policy"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["linux_vps", "docker", "service", "ros2", "isaac_sim", "robot_hardware"]},
          "version": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["registered", "available", "degraded", "unavailable", "disabled"]},
          "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "connection": {
            "type": "object",
            "required": ["mode", "endpoint", "connected"],
            "properties": {
              "mode": {"type": "string", "minLength": 1},
              "endpoint": {"type": ["string", "null"]},
              "connected": {"type": "boolean"}
            }
          },
          "safety_policy": {
            "type": "object",
            "required": ["default_action", "observation_permission", "execution_enabled", "require_tool_executor", "require_approval_for"],
            "properties": {
              "default_action": {"type": "string", "enum": ["deny"]},
              "observation_permission": {"type": "string", "enum": ["READONLY", "CONTROLLED", "ADMIN"]},
              "execution_enabled": {"type": "boolean"},
              "require_tool_executor": {"type": "boolean"},
              "require_approval_for": {"type": "array", "items": {"type": "string", "enum": ["READONLY", "CONTROLLED", "ADMIN"]}}
            }
          }
        }
      }
    },
    "entry_schema": {"type": "object"},
    "validation": {"type": "object"},
    "extensions": {"type": "object"}
  }
}
