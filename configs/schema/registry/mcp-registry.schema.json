{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kai.local/schema/registry/mcp-registry.schema.json",
  "title": "Kai MCP Registry V1.1",
  "type": "object",
  "required": ["version", "default_action", "servers", "defaults", "validation"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "default_action": {"type": "string", "enum": ["deny"]},
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["server_id", "transport", "endpoint", "tools", "health_check", "enabled"],
        "properties": {
          "server_id": {"type": "string", "minLength": 1},
          "transport": {"type": "string", "enum": ["stdio", "streamable_http", "sse"]},
          "endpoint": {"type": ["string", "null"]},
          "tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "health_check": {
            "type": "object",
            "required": ["enabled", "interval_seconds", "timeout_seconds"],
            "properties": {
              "enabled": {"type": "boolean"},
              "interval_seconds": {"type": "integer", "minimum": 1},
              "timeout_seconds": {"type": "integer", "minimum": 1}
            }
          },
          "enabled": {"type": "boolean"}
        }
      }
    },
    "entry_schema": {"type": "object"},
    "defaults": {"type": "object"},
    "validation": {"type": "object"},
    "extensions": {"type": "object"}
  }
}
